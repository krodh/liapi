# Optional overrides. Credentials do NOT live here - they live in auth.json,
# created by `liapi capture` (see docs/auth.md).

# Path to the credential file.
# AUTH_FILE=auth.json

# Pacing between upstream calls, in seconds.
# MIN_DELAY=2.0
# MAX_DELAY=5.0
# TIMEOUT=20.0

# How long a fetched profile stays cached, in seconds.
# CACHE_TTL=3600
